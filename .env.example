# ============================================
# ResumeForge - Environment Variables (template)
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── Database (MySQL) ──
# Local default shown; for Render/Railway use the provider's JDBC URL.
# DB_URL=jdbc:mysql://localhost:3306/resumeforge?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USERNAME=resumeforge
# DB_PASSWORD=choose_a_strong_password

# ── AI (OpenRouter) ──
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model (must be a valid model id from openrouter.ai/models)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Boot user (rarely needed; app uses its own user table) ──
# SECURITY_USER=admin
# SECURITY_PASSWORD=change_me
